#!/bin/sh
# Episode wrapper: reef's LocalExecutor passes only PATH + the descriptor env,
# so the E2B credentials the terminus runner needs are set here, and the
# environment mode selects harbor's remote e2b sandbox.
#
# Credentials come from the environment (export before starting reef serve)
# or, failing that, from bin/e2b.env beside this script (gitignored, for
# machines where the serving environment cannot be extended). The
# reef-terminus binary comes from REEF_TERMINUS_BIN or PATH.
set -e
if [ -z "${E2B_API_KEY:-}" ] || [ -z "${E2B_API_URL:-}" ]; then
    # shellcheck disable=SC1091
    [ -f "$(dirname "$0")/e2b.env" ] && . "$(dirname "$0")/e2b.env"
fi
: "${E2B_API_KEY:?set E2B_API_KEY (see the recipe README)}"
: "${E2B_API_URL:?set E2B_API_URL (e.g. http://<e2b-host>:<port>)}"
export E2B_API_KEY E2B_API_URL
export E2B_SANDBOX_URL="${E2B_SANDBOX_URL:-$E2B_API_URL}"
export E2B_DOMAIN="${E2B_DOMAIN:-${E2B_API_URL#http://}}"
export REEF_TERMINUS_ENVIRONMENT="${REEF_TERMINUS_ENVIRONMENT:-e2b}"
exec "${REEF_TERMINUS_BIN:-reef-terminus}" "$@"
